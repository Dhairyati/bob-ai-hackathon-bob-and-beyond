# C-MAPSS RUL Dashboard Configuration
# Copy this to .env and fill in your actual values

# Data directory path
DATA_DIR=./data

# MongoDB Atlas Connection
# Get your connection string from MongoDB Atlas cluster
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/RUL?retryWrites=true&w=majority

# MongoDB Database name
MONGODB_DB=RUL

# Models directory
MODELS_DIR=./

# Server configuration
HOST=0.0.0.0
PORT=8000

# Frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
